<section class="tank-log">
  <p id="notice"><%= notice %></p>

  <h1>Kangooroule</h1>
  <p class="tank-log__intro">Suivi consommation L/100</p>

  <div class="tank-log__actions">
    <%= link_to "Nouveau", new_tank_path, class: "btn btn-primary" %>
    <%= link_to "Tous les pleins", tanks_path, class: "btn btn-secondary" %>
  </div>

  <table class="tank-table tank-table--details">
    <thead>
      <tr>
        <th scope="col">Date</th>
        <th scope="col">km</th>
        <th scope="col">
          <span class="d-none d-md-inline">Consommation (L / 100)</span>
          <span class="d-md-none">L/100</span>
        </th>
      </tr>
    </thead>
    <tbody>
      <% @tanks.each do |tank| %>
        <tr>
          <td data-label="Date"><%= tank.date.strftime("%d/%m/%y") %></td>
          <td data-label="Kilométrage"><%= tank.distance %></td>
          <td data-label="Consommation (L / 100)"><%= tank.consumption %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="tank-log__actions">
    <%= link_to "Nouveau", new_tank_path, class: "btn btn-primary" %>
    <%= link_to "Tous les pleins", tanks_path, class: "btn btn-secondary" %>
  </div>
</section>
