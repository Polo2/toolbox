<h1>Permacouture - Boite à outils</h1>
<p>Quelques petites outils pratiques pour notre quotidien</p>

<div class="tool-list">
  <div class="card">
    <div class="card-media">
      <img class="card-media__kangoo" src="https://cdn.dribbble.com/users/74401/screenshots/4081641/kangoo-icon.png?compress=1&resize=800x600" alt="kangoo roux">
    </div>
    <div class="card-body">
      <h2 class="card-title">Kangoo roule</h2>
      <p class="card-text">Suivi de la consommation du Kangoo</p>
      <%= link_to "Roule", tanks_path, class: "btn btn-primary" %>
    </div>
  </div>

  <div class="card">
    <div class="card-media">
      <img src="https://upload.wikimedia.org/wikipedia/commons/6/6b/No_Smoking.svg" alt="stop clope">
    </div>
    <div class="card-body">
      <h2 class="card-title">Cigarettes</h2>
      <p class="card-text">Périodes sans clopes</p>
      <%= link_to "Voir", cigarettes_path, class: "btn btn-primary" %>
    </div>
  </div>
</div>
